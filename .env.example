# ==========================================================
# NOC AI-Assisted Incident Management Platform Configuration
# ==========================================================

# Deployment Environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Monitoring Endpoints
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000

# NOC Orchestrator API Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Storage
DATABASE_URL=sqlite:///./incidents/noc_incidents.db

# AI Incident Analysis Provider: mock | gemini | openai | ollama
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Notification Webhooks (Discord, Slack, MS Teams, or n8n)
NOTIFICATION_WEBHOOK_URL=
